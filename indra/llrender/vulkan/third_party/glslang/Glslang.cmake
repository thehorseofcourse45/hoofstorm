include_guard(GLOBAL)
set(LL_GLSLANG_ROOT "${CMAKE_BINARY_DIR}/packages-vulkan" CACHE PATH "Root of the locally installed glslang autobuild package")
if(NOT EXISTS "${LL_GLSLANG_ROOT}/glslang-package.json")
    message(FATAL_ERROR "Install the glslang autobuild archive and set LL_GLSLANG_ROOT; see llrender/vulkan/third_party/glslang/README.md")
endif()
file(READ "${LL_GLSLANG_ROOT}/glslang-package.json" package)
string(JSON package_id GET "${package}" identity)
string(JSON file_count LENGTH "${package}" files)
math(EXPR last_file "${file_count} - 1")
foreach(index RANGE ${last_file})
    string(JSON path MEMBER "${package}" files ${index})
    string(JSON expected GET "${package}" files "${path}")
    if(NOT EXISTS "${LL_GLSLANG_ROOT}/${path}")
        message(FATAL_ERROR "Incomplete glslang package: ${path}")
    endif()
    file(SHA256 "${LL_GLSLANG_ROOT}/${path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "glslang package hash mismatch: ${path}")
    endif()
endforeach()
add_library(ll::glslang INTERFACE IMPORTED GLOBAL)
target_include_directories(ll::glslang SYSTEM INTERFACE "${LL_GLSLANG_ROOT}/include")
target_compile_definitions(ll::glslang INTERFACE LL_GLSLANG_PACKAGE_ID="${package_id}")
foreach(lib glslang SPIRV MachineIndependent GenericCodeGen OSDependent glslang-default-resource-limits SPIRV-Tools-opt SPIRV-Tools)
    target_link_libraries(ll::glslang INTERFACE
        optimized "${LL_GLSLANG_ROOT}/lib/release/${lib}.lib"
        debug "${LL_GLSLANG_ROOT}/lib/debug/${lib}.lib")
endforeach()
